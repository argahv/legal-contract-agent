# =============================================================================
# Legal Agent — environment template (copy to `.env` at repo root)
# =============================================================================
# Backend reads these via `backend/app/core/config.py` (Pydantic Settings).
# Docker Compose injects this file into backend + frontend services.

# --- Application -----------------------------------------------------------
# Deployment flavor: development | staging | production
APP_ENV=development

# --- Database --------------------------------------------------------------
# Async SQLAlchemy URL (asyncpg). In Docker Compose use hostname `db`.
DATABASE_URL=postgresql+asyncpg://legal:legal@db:5432/legal_agent

# Credentials mirrored into the `db` service (must match DATABASE_URL user/db).
POSTGRES_USER=legal
POSTGRES_PASSWORD=legal
POSTGRES_DB=legal_agent

# --- JWT / auth ------------------------------------------------------------
# HS256 signing secret — generate with `openssl rand -hex 32` (≥16 chars required).
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32-in-real-deployments

# Algorithm for access + refresh tokens.
JWT_ALGORITHM=HS256

# Access token TTL. Note: `app/core/config.py` maps env `ACCESS_TOKEN_EXPIRE_MINUTES`.
# Keep JWT_ACCESS_TOKEN_EXPIRE_MINUTES in sync for operators who expect JWT_* names.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Refresh token TTL. Config field uses `REFRESH_TOKEN_EXPIRE_DAYS`.
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM + embeddings (OpenRouter recommended — chat + embeddings on one key/base) ---
# Use OPENROUTER_API_KEY, or keep OPENAI_API_KEY for direct OpenAI.
# If OPENROUTER_BASE_URL / OPENAI_BASE_URL are unset, the backend defaults the OpenAI-compatible base to https://openrouter.ai/api/v1 .
# OPENAI_API_KEY=sk-your-openai-key

# OpenRouter: same key works for https://openrouter.ai/docs (chat + /v1/embeddings).
OPENROUTER_API_KEY=sk-or-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional OpenRouter attribution (see https://openrouter.ai/docs ).
# OPENROUTER_HTTP_REFERER=https://your-site.example
# OPENROUTER_APP_TITLE=Legal Agent

# Chat: OpenRouter ids use a provider prefix. Bare names like gpt-4o-mini are auto-prefixed when base is OpenRouter.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Embeddings: use an OpenRouter embedding model id (see https://openrouter.ai/models?output_modalities=embeddings ).
# Bare OpenAI names (text-embedding-3-small) are rewritten to openai/... when OPENROUTER_BASE_URL points at OpenRouter.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Vector width — 1536 for text-embedding-3-small; use 3072 for text-embedding-3-large (update if you switch models).
VECTOR_DIM=1536

# --- Playbook retrieval + risk cache (Postgres hybrid FTS + pgvector) ------
# HYBRID_PLAYBOOK_RETRIEVAL=true
# PLAYBOOK_VECTOR_POOL=40
# PLAYBOOK_LEX_POOL=40
# PLAYBOOK_RRF_K=60
# PLAYBOOK_RERANK_TOP_N=12
# RISK_PROMPT_VERSION=v1
# RISK_JUDGMENT_CACHE_ENABLED=true
# USE_LANGGRAPH_REVIEW=false
# RISK_USE_REACT=false

# Optional resilience knobs (see Settings aliases in config.py).
# OPENAI_TIMEOUT_SECONDS=90
# OPENAI_MAX_RETRIES=3

# --- LangSmith / LangChain tracing ----------------------------------------
# API key from https://smith.langchain.com — observability for chains in `app/ai/chains/`.
LANGSMITH_API_KEY=

# Project name in LangSmith.
LANGSMITH_PROJECT=legal-agent

# Mirror: LangChain reads `LANGCHAIN_TRACING_V2`. Set true to export traces.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# Optional LangSmith / LangChain endpoint override (enterprise).
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- HTTP / uploads --------------------------------------------------------
# Comma-separated browser origins (add BOTH if you use localhost and 127.0.0.1 interchangeably).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Google Document AI (optional OCR for scanned PDFs) --------------------
# When all three are set, ingestion uses full-document Document AI processing.
# Uses Application Default Credentials (gcloud auth application-default login or workload identity).
# GOOGLE_DOCAI_PROJECT_ID=my-gcp-project
# Region / processor location (default applied in Settings when unset).
# GOOGLE_DOCAI_LOCATION=us
# Processor resource id from Cloud Console (not the display name).
# GOOGLE_DOCAI_PROCESSOR_ID=xxxxxxxxxxxxxxxx

# Per-file cap for contract uploads (MB).
MAX_UPLOAD_MB=25

# Global IP throttle (SlowAPI / app rate limiter).
RATE_LIMIT_PER_MINUTE=120
# Optional burst allowance — used by limiter wiring in app.
RATE_LIMIT_BURST=30

# --- Frontend (Next.js public env) -----------------------------------------
# Browser-visible API base (Docker Compose: backend service on host port 8000).
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket hub URL for realtime review status (adjust when TLS terminates upstream).
NEXT_PUBLIC_WS_URL=ws://localhost:8000
